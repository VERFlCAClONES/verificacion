            if (e.keyCode == 116 || (e.ctrlKey && e.keyCode == 82)) {
                e.preventDefault();
                return false;
            }
        });

        // Prevenir reenvío al usar el botón Atrás/Adelante
        window.history.replaceState(null, null, window.location.href);

