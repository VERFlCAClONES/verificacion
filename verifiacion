                    $get('ctl00_MainContent_UpdateProgress1').style.display = 'block';
                    return true;
                } else {
                    return true;
                }
            }
            return true;
        }

        function MostrarValidarCampoXML() {
            // Mostrar mensaje de error
            var validaTxtXml = document.getElementById('validaTxtXml');
